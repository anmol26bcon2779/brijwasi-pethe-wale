# ==============================================================================
# Brijwasi Pethe Wale — Production Environment Variables Checklist (Vercel)
# ==============================================================================

# 1. Supabase Database & Auth (Both prefixes supported)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternative for Vite client:
# VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend Secret Service Role Key (Server-side only):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_live_yourRazorpayKeyId
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyKeepPrivate
# Frontend public test key (safe for browser client):
VITE_RAZORPAY_KEY_ID=rzp_live_yourRazorpayKeyId

# 3. Store Administration
ADMIN_PASSWORD=brijwasi@admin
PORT=5000
